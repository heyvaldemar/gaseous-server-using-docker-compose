# Gaseous Server + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# GASEOUS_SERVER_IMAGE_TAG=gaseousgames/gaseousserver:v1.7.14@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.gaseous.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Gaseous Server
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
GASEOUS_SERVER_HOSTNAME=gaseous.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
GASEOUS_SERVER_DB_PASSWORD=change_me_before_first_start
GASEOUS_SERVER_DB_ADMIN_PASSWORD=change_me_before_first_start

# The admin account is created in the web UI on first visit.

# IGDB metadata credentials (optional — game covers and metadata):
# https://api-docs.igdb.com/#getting-started
# GASEOUS_SERVER_IGDB_CLIENT_ID=
# GASEOUS_SERVER_IGDB_CLIENT_SECRET=

# Defaults below are set in the compose file; override only to diverge.
# GASEOUS_SERVER_DB_USER=gaseousdbuser
# GASEOUS_SERVER_TIMEZONE=America/New_York

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# MARIADB_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# MARIADB_BACKUPS_PATH=/srv/gaseous-mariadb/backups
# DATA_BACKUPS_PATH=/srv/gaseous-application-data/backups
# DATA_PATH=/root/.gaseous-server
# MARIADB_BACKUP_NAME=gaseous-mariadb-backup
# DATA_BACKUP_NAME=gaseous-application-data-backup

# Every service carries memory and CPU limits plus reservations as
# compose-level defaults; override any of them here and the override survives
# every git pull. Sizing is per host: raise a limit if a service is OOM-killed
# (docker inspect shows OOMKilled=true).
# GASEOUS_SERVER_MARIADB_MEMORY_LIMIT=1g
# GASEOUS_SERVER_MARIADB_CPU_LIMIT=1.0
# GASEOUS_SERVER_MARIADB_MEMORY_RESERVATION=128m
# GASEOUS_SERVER_MARIADB_CPU_RESERVATION=0.25
# GASEOUS_SERVER_MEMORY_LIMIT=2g
# GASEOUS_SERVER_CPU_LIMIT=2.0
# GASEOUS_SERVER_MEMORY_RESERVATION=256m
# GASEOUS_SERVER_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# GASEOUS_SERVER_BACKUPS_MEMORY_LIMIT=256m
# GASEOUS_SERVER_BACKUPS_CPU_LIMIT=0.5
# GASEOUS_SERVER_BACKUPS_MEMORY_RESERVATION=32m
# GASEOUS_SERVER_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits for MariaDB to shut down before it sends SIGKILL.
# The default of ten seconds can cut an InnoDB flush short.
# GASEOUS_SERVER_MARIADB_STOP_GRACE_PERIOD=60s
